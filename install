#!/usr/bin/env bash
set -euo pipefail
APP=axiom3d
REPO=VossGloves/Axiom3D
RELEASE_URL="https://github.com/$REPO/releases"

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
Axiom3D Installer

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 1.2.3)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Examples:
    curl -fsSL https://raw.githubusercontent.com/$REPO/main/install | bash
    curl -fsSL https://raw.githubusercontent.com/$REPO/main/install | bash -s -- --version 1.2.3
    ./install --binary /path/to/axiom3d
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR="${AXIOM3D_HOME:-$HOME/.axiom3d}"
BIN_DIR="$INSTALL_DIR/bin"
LIB_DIR="$INSTALL_DIR/lib"
MARKER="$INSTALL_DIR/version"
mkdir -p "$BIN_DIR" "$LIB_DIR"

# Payload layout installed under $INSTALL_DIR:
#   bin/axiom3d      launcher (exports AXIOM3D_ROOT, OPENCODE_CONFIG_DIR)
#   lib/axiom3d      compiled binary
#   .opencode/       agent + tools + skills + config + plugins + node_modules
#   blender/         harness python (vendor/ filled in below)
#   docs/            conventions doc referenced by opencode.jsonc

write_wrapper() {
    # Bake the actual install dir into the launcher so AXIOM3D_HOME overrides
    # are honored without re-running the installer.
    cat > "$BIN_DIR/$APP" <<WRAPPER
#!/usr/bin/env bash
# Axiom3D launcher: points the compiled CLI at its installed config + harness.
AXIOM3D_HOME="\${AXIOM3D_HOME:-$INSTALL_DIR}"
export AXIOM3D_ROOT="\$AXIOM3D_HOME"
export OPENCODE_CONFIG_DIR="\$AXIOM3D_HOME/.opencode"
export AXIOM3D_BLENDER_MODE="\${AXIOM3D_BLENDER_MODE:-gui}"
exec "\$AXIOM3D_HOME/lib/axiom3d" "\$@"
WRAPPER
    chmod 755 "$BIN_DIR/$APP"

    local uname_s
    uname_s=$(uname -s 2>/dev/null || echo unknown)
    case "$uname_s" in
        MINGW*|MSYS*|CYGWIN*)
            cat > "$BIN_DIR/$APP.cmd" <<CMD
@echo off
setlocal
if not defined AXIOM3D_HOME set "AXIOM3D_HOME=$INSTALL_DIR"
set "AXIOM3D_ROOT=%AXIOM3D_HOME%"
set "OPENCODE_CONFIG_DIR=%AXIOM3D_HOME%\\.opencode"
if not defined AXIOM3D_BLENDER_MODE set "AXIOM3D_BLENDER_MODE=gui"
"%AXIOM3D_HOME%\\lib\\axiom3d.exe" %*
CMD
            ;;
    esac
}

os=""
arch=""
target=""
base_target=""

detect_platform() {
    local raw_os
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      local rosetta_flag
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    local combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    local is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi
      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    local needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ] && ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
        needs_baseline=true
      fi
      if [ "$os" = "darwin" ]; then
        local avx2
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi
      if [ "$os" = "windows" ]; then
        local ps out=""
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    # libfive kernels are built without CPU-specific flags, so they use the
    # plain target regardless of baseline/musl variants of the CLI binary.
    base_target=$(echo "$target" | sed 's/-baseline//; s/-musl//')
}

resolve_version() {
    if [ -n "$requested_version" ]; then
        requested_version="${requested_version#v}"
        specific_version="$requested_version"
        local http_status
        http_status=$(curl -sI -o /dev/null -w "%{http_code}" "$RELEASE_URL/tag/v$specific_version")
        if [ "$http_status" = "404" ]; then
            echo -e "${RED}Error: Release v$specific_version not found${NC}"
            echo -e "${MUTED}Available releases: $RELEASE_URL${NC}"
            exit 1
        fi
        url_base="$RELEASE_URL/download/v$specific_version"
        return
    fi

    specific_version=$(curl -s --retry 3 --retry-all-errors --retry-delay 1 "https://api.github.com/repos/$REPO/releases/latest" \
        | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')
    if [ -z "$specific_version" ]; then
        echo -e "${RED}Failed to fetch version information${NC}"
        exit 1
    fi
    url_base="$RELEASE_URL/download/v$specific_version"
}

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

already_installed() {
    local installed=""
    [ -f "$MARKER" ] && installed=$(cat "$MARKER")
    local exe=""
    [ -x "$LIB_DIR/axiom3d" ] && exe="axiom3d"
    [ -x "$LIB_DIR/axiom3d.exe" ] && exe="axiom3d.exe"
    if [ "$installed" = "$specific_version" ] && [ -x "$BIN_DIR/$APP" ] && [ -n "$exe" ]; then
        print_message info "${MUTED}Axiom3D ${NC}$specific_version${MUTED} already installed${NC}"
        return 0
    fi
    return 1
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad
        pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled
    filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty
    empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tmp_dir=${TMPDIR:-/tmp}
    local basename="${tmp_dir}/axiom3d_install_$$"
    local tracefile="${basename}.trace"

    rm -f "$tracefile"
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -f \"$tracefile\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        curl --trace-ascii "$tracefile" -s --retry 3 --retry-all-errors --retry-delay 1 \
            --speed-limit 1024 --speed-time 30 -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

fetch() {
    # fetch <url> <output>; falls back to plain curl when the traced progress
    # reader is unavailable (non-TTY, Windows). Both paths retry transient
    # CDN resets mid-download.
    local url="$1"
    local output="$2"
    if [ -t 2 ] && ! [[ "$os" == "windows" ]]; then
        if download_with_progress "$url" "$output"; then
            return 0
        fi
    fi
    # --speed-* aborts silent stalls so --retry can restart the transfer.
    curl -# --retry 3 --retry-all-errors --retry-delay 1 \
        --speed-limit 1024 --speed-time 30 -L -o "$output" "$url"
}

extract_binary() {
    print_message info "\n${MUTED}Installing ${NC}axiom3d ${MUTED}version: ${NC}$specific_version"
    local tmp_dir="${TMPDIR:-/tmp}/axiom3d_install_$$"
    mkdir -p "$tmp_dir"
    local filename="axiom3d-$target$archive_ext"

    fetch "$url_base/$filename" "$tmp_dir/$filename"

    if [ "$os" = "linux" ] || [ "$os" = "darwin" ]; then
        tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    else
        unzip -q "$tmp_dir/$filename" -d "$tmp_dir"
    fi
    # The archive itself also matches axiom3d*; pick the extracted executable.
    local binary
    binary=$(find "$tmp_dir" -maxdepth 2 -type f \( -name 'axiom3d' -o -name 'axiom3d.exe' \) | head -1)
    if [ -z "$binary" ]; then
        echo -e "${RED}Error: no binary found in $filename${NC}"
        exit 1
    fi

    local exe_suffix=""
    [[ "$binary" == *.exe ]] && exe_suffix=".exe"
    mv "$binary" "$LIB_DIR/axiom3d$exe_suffix"
    chmod 755 "$LIB_DIR/axiom3d$exe_suffix"
    rm -rf "$tmp_dir"

    if [ "$os" = "darwin" ] && command -v codesign >/dev/null 2>&1; then
        # Release binaries are built on Linux and carry no signature; arm64
        # macOS refuses to exec unsigned code, so sign ad-hoc on install.
        codesign --force --sign - "$LIB_DIR/axiom3d" 2>/dev/null \
            || print_message warning "${MUTED}ad-hoc codesign failed; the binary may be blocked by Gatekeeper${NC}"
    fi
}

extract_payload() {
    print_message info "${MUTED}Installing config + Blender harness${NC}"
    local tmp_dir="${TMPDIR:-/tmp}/axiom3d_payload_$$"
    mkdir -p "$tmp_dir"

    fetch "$url_base/axiom3d-common.tar.gz" "$tmp_dir/axiom3d-common.tar.gz"
    # Fresh payload: drop the previous config/harness so renamed files don't
    # linger across upgrades.
    rm -rf "$INSTALL_DIR/.opencode" "$INSTALL_DIR/blender" "$INSTALL_DIR/docs"
    tar -xzf "$tmp_dir/axiom3d-common.tar.gz" -C "$INSTALL_DIR"
    rm -rf "$tmp_dir"

    # libfive native kernels for this platform (python bindings ship in the
    # payload, native libs do not).
    tmp_dir="${TMPDIR:-/tmp}/axiom3d_libfive_$$"
    mkdir -p "$tmp_dir"
    fetch "$url_base/libfive-$base_target.tar.gz" "$tmp_dir/libfive-$base_target.tar.gz"
    mkdir -p "$INSTALL_DIR/blender/vendor"
    rm -rf "$INSTALL_DIR/blender/vendor/libfive"
    tar -xzf "$tmp_dir/libfive-$base_target.tar.gz" -C "$INSTALL_DIR/blender/vendor"
    rm -rf "$tmp_dir"
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}axiom3d ${MUTED}from: ${NC}$binary_path"
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    cp "$binary_path" "$LIB_DIR/axiom3d"
    chmod 755 "$LIB_DIR/axiom3d"
    print_message warning "${MUTED}Note: --binary installs only the binary; config + harness come from a full install${NC}"
}

find_blender() {
    if [ -n "${BLENDER_PATH:-}" ]; then
        echo "$BLENDER_PATH"
        return 0
    fi
    if command -v blender >/dev/null 2>&1; then
        command -v blender
        return 0
    fi
    if [ -x "/Applications/Blender.app/Contents/MacOS/Blender" ]; then
        echo "/Applications/Blender.app/Contents/MacOS/Blender"
        return 0
    fi
    local candidate
    for candidate in "/c/Program Files/Blender Foundation"/Blender*/blender.exe \
                     "/mnt/c/Program Files/Blender Foundation"/Blender*/blender.exe; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

bootstrap_blender_deps() {
    if [ ! -f "$INSTALL_DIR/blender/bootstrap.py" ]; then
        return 0
    fi
    if [ -d "$INSTALL_DIR/blender/vendor/scipy" ]; then
        return 0
    fi
    local blender
    if ! blender=$(find_blender); then
        print_message warning "${MUTED}Blender not found — install Blender 5.2, then re-run this installer${NC}"
        print_message info "  ${MUTED}https://www.blender.org/download/ (or: brew install --cask blender)${NC}"
        return 0
    fi
    print_message info "${MUTED}Installing Python deps into Blender's interpreter (scipy, trimesh)${NC}"
    if ! "$blender" --background --factory-startup --python "$INSTALL_DIR/blender/bootstrap.py"; then
        print_message warning "${MUTED}Dependency bootstrap failed — blender-gate geometry checks will be degraded${NC}"
        print_message info "  ${MUTED}retry: $blender --background --factory-startup --python $INSTALL_DIR/blender/bootstrap.py${NC}"
    fi
}

add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# axiom3d" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}axiom3d ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "${SHELL:-bash}")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

main() {
    if [ -n "$binary_path" ]; then
        install_from_binary
        write_wrapper
        specific_version="local"
    else
        detect_platform
        if [ "$os" = "darwin" ]; then
            archive_ext=".tar.gz"
        elif [ "$os" = "linux" ]; then
            archive_ext=".tar.gz"
        else
            archive_ext=".zip"
        fi
        resolve_version
        if ! already_installed; then
            extract_binary
            extract_payload
            write_wrapper
            echo "$specific_version" > "$MARKER"
        fi
    fi

    bootstrap_blender_deps

    if [[ "$no_modify_path" != "true" ]]; then
        local config_file=""
        local file
        for file in $config_files; do
            if [[ -f $file ]]; then
                config_file=$file
                break
            fi
        done

        if [[ -z $config_file ]]; then
            print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
            print_message info "  export PATH=$BIN_DIR:\$PATH"
        elif [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
            case $current_shell in
                fish)
                    add_to_path "$config_file" "fish_add_path $BIN_DIR"
                ;;
                *)
                    add_to_path "$config_file" "export PATH=$BIN_DIR:\$PATH"
                ;;
            esac
        fi
    fi

    if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
        echo "$BIN_DIR" >> $GITHUB_PATH
        print_message info "Added $BIN_DIR to \$GITHUB_PATH"
    fi

    echo -e ""
    echo -e "${MUTED}  axiom3d — Blender asset agent for Axiom3D${NC}"
    echo -e ""
    echo -e "  Installed: ${NC}$INSTALL_DIR${MUTED} (version ${NC}$specific_version${MUTED})${NC}"
    echo -e ""
    if [ -z "$(find_blender || true)" ]; then
        echo -e "  ${ORANGE}Blender 5.2 not found.${NC} Install it, then re-run this installer"
        echo -e "  ${MUTED}to fetch Python deps:  https://www.blender.org/download/${NC}"
        echo -e ""
    fi
    echo -e "  ${MUTED}To start:${NC}"
    echo -e ""
    echo -e "cd <project>  ${MUTED}# Open directory${NC}"
    echo -e "axiom3d       ${MUTED}# Run command${NC}"
    echo -e ""
    echo -e "${MUTED}Docs: $REPO${NC}"
    echo -e ""
}

main
